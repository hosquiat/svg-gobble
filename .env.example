# Database URL (SQLite, path relative to prisma/schema.prisma)
DATABASE_URL="file:./data/svg-gobble.db"

# Backup directory (absolute path)
BACKUP_DIR=/app/backups

# Google Drive OAuth (optional - for backup to Google Drive)
# Get credentials from https://console.cloud.google.com
# 1. Create a project or select existing
# 2. Enable Google Drive API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add redirect URI: http://localhost:3000/api/google-drive/oauth-callback
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/oauth-callback

DATABASE_TYPE=mysql
DATABASE_URL=mysql://<DB_USER>:<DB_PASS>@<DB_HOST>:3306/<DB_NAME>
